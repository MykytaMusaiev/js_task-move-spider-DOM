    var maxLeft = wall.offsetWidth - spider.offsetWidth;
    var clickX = e.clientX - wallRect.left;
    var clickY = e.clientY - wallRect.top;
    var finalTop = clickY - spider.offsetHeight / 2;
    var finalLeft = clickX - spider.offsetWidth / 2;
    finalTop = Math.max(0, Math.min(finalTop, maxTop));
